# ==============================================================================
# O2O Food Pickup System - Environment Configuration (.env.example)
# Copy this file to .env and adjust values as needed before running Docker Compose
# ==============================================================================

# Timezone Standardization (Mandatory: Asia/Ho_Chi_Minh UTC+07:00)
TZ=Asia/Ho_Chi_Minh

# SQL Server 2022 Configuration
MSSQL_SA_PASSWORD=O2oFood@StrongPass2026!
MSSQL_DB_NAME=o2ofood_db
MSSQL_PORT=1433

# Spring Boot Backend Configuration
API_PORT=8080
SPRING_PROFILES_ACTIVE=prod
DB_URL=jdbc:sqlserver://sqlserver:1433;databaseName=o2ofood_db;encrypt=true;trustServerCertificate=true;sendTimeAsDateTime=false
DB_USERNAME=sa
DB_PASSWORD=O2oFood@StrongPass2026!

# JWT Authentication Configuration
JWT_SECRET=O2oFoodPickupSystem2026SuperSecretKeyForHmacSha512MustBeAtLeast64BytesLong!
JWT_ACCESS_EXPIRATION_MS=3600000
JWT_REFRESH_EXPIRATION_MS=604800000

# VNPAY Sandbox Configuration (100% Prepayment - No COD)
VNPAY_TMN_CODE=DEMO_O2OFOOD
VNPAY_HASH_SECRET=VNPAYSANDBOXSECRETKEY2026O2OFOODPICKUP
VNPAY_PAY_URL=https://sandbox.vnpayment.vn/paymentv2/vpcpay.html
VNPAY_RETURN_URL=http://localhost:5173/payment/vnpay-return
VNPAY_IPN_URL=https://your-tunnel-domain.trycloudflare.com/api/v1/payments/vnpay-ipn

# Order Cycle & Operational Parameters (Asia/Ho_Chi_Minh)
CYCLE_PAYMENT_TIMEOUT_MINUTES=30
CYCLE_DEFAULT_CUTOFF_TIME=23:59:59
CYCLE_DEFAULT_AUTO_CONFIRM_TIME=00:00:00
CYCLE_DEFAULT_WAREHOUSE_PACK_TARGET_TIME=08:00:00
CYCLE_DEFAULT_DISPATCH_START_TIME=08:00:00
CYCLE_DEFAULT_PICKUP_START_TIME=16:00:00
CYCLE_DEFAULT_AUTO_COMPLETE_TIME=00:00:00

# AI Assistant (Policy RAG + Order Tool-Calling + Recipe Suggestion)
AI_PROVIDER=GEMINI
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-2.5-flash

# Web Frontend Configuration
WEB_PORT=80
VITE_API_BASE_URL=/api/v1

# Cloudflared Tunnel (For VNPAY IPN Webhook & Mobile Testing)
CLOUDFLARED_TUNNEL_TOKEN=
